<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>InactivePDF.Api</RootNamespace>
    <AssemblyName>InactivePDF.Api</AssemblyName>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <Content Update="wwwroot/**/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <ProjectReference Include="../InactivePDF.Application/InactivePDF.Application.csproj" />
    <ProjectReference Include="../InactivePDF.Infrastructure/InactivePDF.Infrastructure.csproj" />
    <ProjectReference Include="../InactivePDF.ConversionWorker/InactivePDF.ConversionWorker.csproj" ReferenceOutputAssembly="false" />
    <None Include="../../InactivePDF.settings.json" Link="InactivePDF.settings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopyConversionWorkerArtifacts" AfterTargets="Build">
    <ItemGroup>
      <ConversionWorkerArtifacts Include="$(MSBuildProjectDirectory)/../InactivePDF.ConversionWorker/bin/$(Configuration)/net10.0/*"
                                  Exclude="$(MSBuildProjectDirectory)/../InactivePDF.ConversionWorker/bin/$(Configuration)/net10.0/InactivePDF.Application.dll;$(MSBuildProjectDirectory)/../InactivePDF.ConversionWorker/bin/$(Configuration)/net10.0/InactivePDF.Domain.dll;$(MSBuildProjectDirectory)/../InactivePDF.ConversionWorker/bin/$(Configuration)/net10.0/InactivePDF.Infrastructure.dll;$(MSBuildProjectDirectory)/../InactivePDF.ConversionWorker/bin/$(Configuration)/net10.0/InactivePDF.Application.pdb;$(MSBuildProjectDirectory)/../InactivePDF.ConversionWorker/bin/$(Configuration)/net10.0/InactivePDF.Domain.pdb;$(MSBuildProjectDirectory)/../InactivePDF.ConversionWorker/bin/$(Configuration)/net10.0/InactivePDF.Infrastructure.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(ConversionWorkerArtifacts)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyCurrentProjectReferences" AfterTargets="CopyConversionWorkerArtifacts">
    <ItemGroup>
      <CurrentProjectReferenceArtifacts Include="$(MSBuildProjectDirectory)/../InactivePDF.Application/bin/$(Configuration)/net10.0/InactivePDF.Application.dll;$(MSBuildProjectDirectory)/../InactivePDF.Domain/bin/$(Configuration)/net10.0/InactivePDF.Domain.dll;$(MSBuildProjectDirectory)/../InactivePDF.Infrastructure/bin/$(Configuration)/net10.0/InactivePDF.Infrastructure.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(CurrentProjectReferenceArtifacts)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
