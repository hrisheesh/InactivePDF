{
  "openapi": "3.0.3",
  "info": {
    "title": "InactivePDF API",
    "version": "0.1.0-beta",
    "description": "Self-hosted document-to-PDF conversion API. Use an administrator bearer token for administration routes or a scoped integration key for conversion and owned-job routes."
  },
  "servers": [{ "url": "/", "description": "Current InactivePDF instance" }],
  "tags": [
    { "name": "Health" },
    { "name": "Conversion" },
    { "name": "Jobs" },
    { "name": "Profiles" },
    { "name": "Administration" }
  ],
  "paths": {
    "/health": { "get": { "tags": ["Health"], "summary": "Process liveness", "responses": { "200": { "description": "The API process is alive." } } } },
    "/ready": { "get": { "tags": ["Health"], "summary": "Conversion readiness", "responses": { "200": { "description": "The service is ready." }, "503": { "$ref": "#/components/responses/Problem" } } } },
    "/v1/capabilities": { "get": { "tags": ["Health"], "summary": "List supported operations, formats, and profiles", "security": [{ "administratorBearer": [] }], "responses": { "200": { "description": "Capabilities", "content": { "application/json": { "schema": { "type": "object" } } } }, "401": { "$ref": "#/components/responses/Problem" }, "403": { "$ref": "#/components/responses/Problem" } } } },
    "/v1/conversions": { "post": { "tags": ["Conversion"], "summary": "Convert one or more files", "description": "Send multipart fields mode=sync or async, profile, watermarkProfile, and optional JSON watermark. Async returns 202 with a job location; sync streams the PDF.", "security": [{ "integrationBearer": [] }, { "administratorBearer": [] }], "requestBody": { "$ref": "#/components/requestBodies/ConversionMultipart" }, "responses": { "200": { "$ref": "#/components/responses/Pdf" }, "202": { "$ref": "#/components/responses/AcceptedJob" }, "400": { "$ref": "#/components/responses/Problem" }, "401": { "$ref": "#/components/responses/Problem" }, "413": { "$ref": "#/components/responses/Problem" }, "422": { "$ref": "#/components/responses/Problem" } } } },
    "/v1/convert-file": { "post": { "tags": ["Conversion"], "summary": "Convert one file synchronously", "security": [{ "integrationBearer": [] }, { "administratorBearer": [] }], "requestBody": { "$ref": "#/components/requestBodies/ConversionMultipart" }, "responses": { "200": { "$ref": "#/components/responses/Pdf" }, "default": { "$ref": "#/components/responses/Problem" } } } },
    "/v1/create-text-pdf": { "post": { "tags": ["Conversion"], "summary": "Create a PDF from text", "security": [{ "integrationBearer": [] }, { "administratorBearer": [] }], "parameters": [{ "name": "watermarkProfile", "in": "query", "schema": { "type": "string" }, "description": "Optional saved watermark profile; direct watermark options in the body take precedence." }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TextPdfRequest" }, "example": { "text": "Hello from InactivePDF", "profile": "archive" } } } }, "responses": { "200": { "$ref": "#/components/responses/Pdf" }, "default": { "$ref": "#/components/responses/Problem" } } } },
    "/v1/convert-and-merge": { "post": { "tags": ["Conversion"], "summary": "Convert and merge files synchronously", "security": [{ "integrationBearer": [] }, { "administratorBearer": [] }], "requestBody": { "$ref": "#/components/requestBodies/ConversionMultipart" }, "responses": { "200": { "$ref": "#/components/responses/Pdf" }, "default": { "$ref": "#/components/responses/Problem" } } } },
    "/v1/jobs": {
      "post": { "tags": ["Jobs"], "summary": "Submit an asynchronous job", "security": [{ "integrationBearer": [] }, { "administratorBearer": [] }], "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "$ref": "#/components/requestBodies/JobMultipart" }, "responses": { "202": { "$ref": "#/components/responses/AcceptedJob" }, "default": { "$ref": "#/components/responses/Problem" } } },
      "get": { "tags": ["Jobs"], "summary": "List owned jobs", "security": [{ "integrationBearer": [] }, { "administratorBearer": [] }], "parameters": [{ "$ref": "#/components/parameters/State" }, { "$ref": "#/components/parameters/Format" }, { "$ref": "#/components/parameters/Limit" }, { "$ref": "#/components/parameters/Cursor" }], "responses": { "200": { "description": "A cursor-paginated job list.", "content": { "application/json": { "schema": { "type": "object" } } } }, "default": { "$ref": "#/components/responses/Problem" } } }
    },
    "/v1/jobs/{jobId}/output": { "get": { "tags": ["Jobs"], "summary": "Download a completed PDF", "security": [{ "integrationBearer": [] }, { "administratorBearer": [] }], "parameters": [{ "$ref": "#/components/parameters/JobId" }], "responses": { "200": { "$ref": "#/components/responses/Pdf" }, "404": { "$ref": "#/components/responses/Problem" } } } },
    "/v1/jobs/{jobId}/cancel": { "post": { "tags": ["Jobs"], "summary": "Cancel an owned active job", "security": [{ "integrationBearer": [] }, { "administratorBearer": [] }], "parameters": [{ "$ref": "#/components/parameters/JobId" }], "responses": { "200": { "description": "Updated job status" }, "default": { "$ref": "#/components/responses/Problem" } } } },
    "/v1/jobs/{jobId}/retry": { "post": { "tags": ["Jobs"], "summary": "Retry an owned failed job", "security": [{ "integrationBearer": [] }, { "administratorBearer": [] }], "parameters": [{ "$ref": "#/components/parameters/JobId" }], "responses": { "202": { "$ref": "#/components/responses/AcceptedJob" }, "default": { "$ref": "#/components/responses/Problem" } } } },
    "/v1/jobs/{jobId}": { "get": { "tags": ["Jobs"], "summary": "Read job status", "security": [{ "integrationBearer": [] }, { "administratorBearer": [] }], "parameters": [{ "$ref": "#/components/parameters/JobId" }], "responses": { "200": { "description": "Job status", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/JobStatus" } } } }, "404": { "$ref": "#/components/responses/Problem" } } }, "delete": { "tags": ["Jobs"], "summary": "Delete a terminal owned job", "security": [{ "integrationBearer": [] }, { "administratorBearer": [] }], "parameters": [{ "$ref": "#/components/parameters/JobId" }], "responses": { "204": { "description": "Deleted" }, "default": { "$ref": "#/components/responses/Problem" } } } },
    "/v1/profiles": { "get": { "tags": ["Profiles"], "summary": "List output and watermark profiles", "security": [{ "integrationBearer": [] }, { "administratorBearer": [] }], "responses": { "200": { "description": "Profile catalog", "content": { "application/json": { "schema": { "type": "object" } } } } } } },
    "/v1/profiles/{name}": { "get": { "tags": ["Profiles"], "summary": "Look up a named profile", "security": [{ "integrationBearer": [] }, { "administratorBearer": [] }], "parameters": [{ "name": "name", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Profile definition" }, "404": { "$ref": "#/components/responses/Problem" } } } },
    "/v1/watermark-profiles": { "get": { "tags": ["Profiles"], "summary": "List watermark profiles", "security": [{ "integrationBearer": [] }, { "administratorBearer": [] }], "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/v1/watermark-profiles/{name}": { "get": { "tags": ["Profiles"], "summary": "Read a watermark profile", "security": [{ "integrationBearer": [] }, { "administratorBearer": [] }], "parameters": [{ "name": "name", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "$ref": "#/components/responses/Json" }, "404": { "$ref": "#/components/responses/Problem" } } }, "put": { "tags": ["Profiles"], "summary": "Replace a watermark profile", "security": [{ "administratorBearer": [] }], "parameters": [{ "name": "name", "in": "path", "required": true, "schema": { "type": "string" } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WatermarkOptions" } } } }, "responses": { "200": { "$ref": "#/components/responses/Json" }, "400": { "$ref": "#/components/responses/Problem" }, "default": { "$ref": "#/components/responses/Problem" } } }, "delete": { "tags": ["Profiles"], "summary": "Delete a watermark profile", "security": [{ "administratorBearer": [] }], "parameters": [{ "name": "name", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "204": { "description": "Deleted" }, "default": { "$ref": "#/components/responses/Problem" } } } },
    "/v1/watermark-assets": { "get": { "tags": ["Profiles"], "summary": "List watermark assets", "security": [{ "integrationBearer": [] }, { "administratorBearer": [] }], "responses": { "200": { "$ref": "#/components/responses/Json" } } }, "post": { "tags": ["Profiles"], "summary": "Upload a watermark asset", "security": [{ "administratorBearer": [] }], "requestBody": { "required": true, "content": { "multipart/form-data": { "schema": { "type": "object", "properties": { "file": { "type": "string", "format": "binary" } }, "required": ["file"] } } } }, "responses": { "200": { "$ref": "#/components/responses/Json" }, "default": { "$ref": "#/components/responses/Problem" } } } },
    "/v1/watermark-assets/{name}": { "get": { "tags": ["Profiles"], "summary": "Download a watermark asset", "security": [{ "integrationBearer": [] }, { "administratorBearer": [] }], "parameters": [{ "name": "name", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Image asset", "content": { "image/*": { "schema": { "type": "string", "format": "binary" } } } }, "404": { "$ref": "#/components/responses/Problem" } } } },
    "/v1/metrics": { "get": { "tags": ["Administration"], "summary": "Read process-local counters", "security": [{ "administratorBearer": [] }], "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/v1/queue": { "get": { "tags": ["Administration"], "summary": "Read in-memory queue depth", "security": [{ "administratorBearer": [] }], "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/v1/dead-letters": { "get": { "tags": ["Administration"], "summary": "List dead-letter jobs", "security": [{ "administratorBearer": [] }], "parameters": [{ "$ref": "#/components/parameters/Limit" }], "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/v1/dead-letters/{jobId}/replay": { "post": { "tags": ["Administration"], "summary": "Replay a dead-letter job", "security": [{ "administratorBearer": [] }], "parameters": [{ "$ref": "#/components/parameters/JobId" }], "responses": { "202": { "$ref": "#/components/responses/AcceptedJob" }, "default": { "$ref": "#/components/responses/Problem" } } } },
    "/v1/admin/api-keys": {
      "get": { "tags": ["Administration"], "summary": "List API-key metadata", "security": [{ "administratorBearer": [] }], "responses": { "200": { "description": "Key metadata. Secrets are never returned." } } },
      "post": { "tags": ["Administration"], "summary": "Create an integration API key", "security": [{ "administratorBearer": [] }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiKeyCreateRequest" } } } }, "responses": { "201": { "description": "Metadata and the one-time secret" }, "default": { "$ref": "#/components/responses/Problem" } } }
    },
    "/v1/admin/api-keys/{id}": { "get": { "tags": ["Administration"], "summary": "Read API-key metadata", "security": [{ "administratorBearer": [] }], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "responses": { "200": { "$ref": "#/components/responses/Json" }, "404": { "$ref": "#/components/responses/Problem" } } }, "delete": { "tags": ["Administration"], "summary": "Delete an API key", "security": [{ "administratorBearer": [] }], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "responses": { "204": { "description": "Deleted" }, "default": { "$ref": "#/components/responses/Problem" } } } },
    "/v1/admin/api-keys/{id}/rotate": { "post": { "tags": ["Administration"], "summary": "Rotate an API key", "security": [{ "administratorBearer": [] }], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "responses": { "200": { "$ref": "#/components/responses/Json" }, "default": { "$ref": "#/components/responses/Problem" } } } },
    "/v1/admin/api-keys/{id}/revoke": { "post": { "tags": ["Administration"], "summary": "Revoke an API key", "security": [{ "administratorBearer": [] }], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "responses": { "200": { "$ref": "#/components/responses/Json" }, "default": { "$ref": "#/components/responses/Problem" } } } },
    "/v1/admin/api-keys/{id}/limits": { "put": { "tags": ["Administration"], "summary": "Update API-key limits", "security": [{ "administratorBearer": [] }], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object" } } } }, "responses": { "200": { "$ref": "#/components/responses/Json" }, "default": { "$ref": "#/components/responses/Problem" } } } },
    "/v1/admin/api-keys/{id}/usage": { "get": { "tags": ["Administration"], "summary": "Get usage for one API key", "security": [{ "administratorBearer": [] }], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "responses": { "200": { "$ref": "#/components/responses/Json" }, "404": { "$ref": "#/components/responses/Problem" } } } },
    "/v1/admin/profiles": { "post": { "tags": ["Administration"], "summary": "Create a watermark profile", "security": [{ "administratorBearer": [] }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProfileWriteRequest" } } } }, "responses": { "201": { "$ref": "#/components/responses/Json" }, "400": { "$ref": "#/components/responses/Problem" }, "409": { "$ref": "#/components/responses/Problem" } } } },
    "/v1/admin/profiles/{name}": { "put": { "tags": ["Administration"], "summary": "Update a watermark profile", "security": [{ "administratorBearer": [] }], "parameters": [{ "name": "name", "in": "path", "required": true, "schema": { "type": "string" } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProfileWriteRequest" } } } }, "responses": { "200": { "$ref": "#/components/responses/Json" }, "400": { "$ref": "#/components/responses/Problem" } } }, "delete": { "tags": ["Administration"], "summary": "Delete a watermark profile", "security": [{ "administratorBearer": [] }], "parameters": [{ "name": "name", "in": "path", "required": true, "schema": { "type": "string" } }, { "name": "type", "in": "query", "schema": { "type": "string", "enum": ["watermark"] } }], "responses": { "204": { "description": "Deleted" }, "404": { "$ref": "#/components/responses/Problem" } } } },
    "/v1/admin/performance-presets": { "get": { "tags": ["Administration"], "summary": "List built-in performance presets", "security": [{ "administratorBearer": [] }], "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/v1/admin/service-profiles": { "get": { "tags": ["Administration"], "summary": "List saved service profiles", "security": [{ "administratorBearer": [] }], "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/v1/admin/service-profiles/{name}": { "get": { "tags": ["Administration"], "summary": "Read a saved service profile", "security": [{ "administratorBearer": [] }], "parameters": [{ "name": "name", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "$ref": "#/components/responses/Json" }, "404": { "$ref": "#/components/responses/Problem" } } }, "put": { "tags": ["Administration"], "summary": "Replace a saved service profile", "security": [{ "administratorBearer": [] }], "parameters": [{ "name": "name", "in": "path", "required": true, "schema": { "type": "string" } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object" } } } }, "responses": { "204": { "description": "Saved" }, "400": { "$ref": "#/components/responses/Problem" } } }, "delete": { "tags": ["Administration"], "summary": "Delete a saved service profile", "security": [{ "administratorBearer": [] }], "parameters": [{ "name": "name", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "204": { "description": "Deleted" }, "404": { "$ref": "#/components/responses/Problem" } } } },
    "/v1/admin/usage": { "get": { "tags": ["Administration"], "summary": "Get all API-key usage and totals", "security": [{ "administratorBearer": [] }], "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/v1/admin/audit-events": { "get": { "tags": ["Administration"], "summary": "Read safe audit events", "security": [{ "administratorBearer": [] }], "parameters": [{ "$ref": "#/components/parameters/Limit" }], "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/v1/admin/settings": { "get": { "tags": ["Administration"], "summary": "Read effective settings", "security": [{ "administratorBearer": [] }], "responses": { "200": { "$ref": "#/components/responses/Json" } } }, "put": { "tags": ["Administration"], "summary": "Save settings with optimistic concurrency", "security": [{ "administratorBearer": [] }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["settings", "revision"] } } } }, "responses": { "200": { "$ref": "#/components/responses/Json" }, "409": { "$ref": "#/components/responses/Problem" }, "default": { "$ref": "#/components/responses/Problem" } } } },
    "/v1/admin/status": { "get": { "tags": ["Administration"], "summary": "Read health and runtime status", "security": [{ "administratorBearer": [] }], "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/v1/admin/jobs": { "get": { "tags": ["Administration"], "summary": "List recent jobs for operators", "security": [{ "administratorBearer": [] }], "parameters": [{ "$ref": "#/components/parameters/Limit" }], "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/v1/admin/logs": { "get": { "tags": ["Administration"], "summary": "Read structured operator logs", "security": [{ "administratorBearer": [] }], "parameters": [{ "name": "q", "in": "query", "schema": { "type": "string", "maxLength": 128 } }], "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/v1/admin/live": { "get": { "tags": ["Administration"], "summary": "Stream live operational snapshots", "description": "Server-sent events emitted every two seconds. Pass source=WatchFolder, Synchronous, or Queued to filter analytics.", "security": [{ "administratorBearer": [] }], "responses": { "200": { "description": "text/event-stream" }, "default": { "$ref": "#/components/responses/Problem" } } } },
    "/v1/admin/analytics": { "get": { "tags": ["Administration"], "summary": "Read conversion analytics", "security": [{ "administratorBearer": [] }], "parameters": [{ "name": "hours", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 168, "default": 24 } }, { "name": "source", "in": "query", "schema": { "type": "string", "enum": ["WatchFolder", "Synchronous", "Queued"] } }], "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/v1/admin/search": { "get": { "tags": ["Administration"], "summary": "Search operator metadata", "security": [{ "administratorBearer": [] }], "parameters": [{ "name": "q", "in": "query", "required": true, "schema": { "type": "string", "minLength": 2, "maxLength": 128 } }, { "$ref": "#/components/parameters/Limit" }], "responses": { "200": { "$ref": "#/components/responses/Json" }, "default": { "$ref": "#/components/responses/Problem" } } } }
  },
  "components": {
    "securitySchemes": {
      "administratorBearer": { "type": "http", "scheme": "bearer", "bearerFormat": "administrator token" },
      "integrationBearer": { "type": "http", "scheme": "bearer", "bearerFormat": "integration API key" }
    },
    "parameters": {
      "JobId": { "name": "jobId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
      "IdempotencyKey": { "name": "Idempotency-Key", "in": "header", "schema": { "type": "string", "maxLength": 128 }, "description": "Repeat-safe identity for asynchronous submissions." },
      "State": { "name": "state", "in": "query", "schema": { "type": "string" } },
      "Format": { "name": "format", "in": "query", "schema": { "type": "string" } },
      "Limit": { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 1000, "default": 50 } },
      "Cursor": { "name": "cursor", "in": "query", "schema": { "type": "string" } }
    },
    "requestBodies": {
      "ConversionMultipart": { "required": true, "content": { "multipart/form-data": { "schema": { "$ref": "#/components/schemas/ConversionForm" } } } },
      "JobMultipart": { "required": true, "content": { "multipart/form-data": { "schema": { "$ref": "#/components/schemas/JobForm" } } } }
    },
    "schemas": {
      "WatermarkOptions": { "type": "object", "properties": { "kind": { "type": "string", "enum": ["Text", "Image"], "default": "Text" }, "text": { "type": "string" }, "imagePath": { "type": "string", "description": "Protected asset filename, never an arbitrary server path." }, "fontFamily": { "type": "string", "default": "Arial" }, "fontSize": { "type": "number", "format": "double", "minimum": 1 }, "color": { "type": "string", "example": "#808080" }, "opacity": { "type": "number", "format": "double", "minimum": 0, "maximum": 1 }, "rotation": { "type": "number", "format": "double", "minimum": -360, "maximum": 360 }, "position": { "type": "string", "enum": ["TopLeft", "TopCenter", "TopRight", "CenterLeft", "Center", "CenterRight", "BottomLeft", "BottomCenter", "BottomRight"] }, "offsetX": { "type": "number", "format": "double" }, "offsetY": { "type": "number", "format": "double" }, "layer": { "type": "string", "enum": ["Behind", "Over"] }, "pages": { "type": "string", "example": "all" }, "tile": { "type": "boolean" }, "width": { "type": "number", "format": "double", "exclusiveMinimum": 0 }, "height": { "type": "number", "format": "double", "exclusiveMinimum": 0 }, "header": { "type": "string", "nullable": true }, "footer": { "type": "string", "nullable": true }, "pageNumberFormat": { "type": "string", "default": "{page}/{pages}" } }, "description": "WatermarkOptions. When only one image dimension is supplied, the other is derived proportionally." },
      "ProfileWriteRequest": { "type": "object", "required": ["type", "options"], "properties": { "name": { "type": "string" }, "type": { "type": "string", "enum": ["watermark"] }, "options": { "$ref": "#/components/schemas/WatermarkOptions" } } },
      "ConversionForm": { "type": "object", "required": ["file"], "properties": { "mode": { "type": "string", "enum": ["sync", "async"], "default": "async" }, "profile": { "type": "string", "default": "archive" }, "watermarkProfile": { "type": "string" }, "watermark": { "type": "string", "description": "JSON-encoded WatermarkOptions for multipart requests. Direct options take precedence over watermarkProfile." }, "file": { "type": "array", "items": { "type": "string", "format": "binary" } } } },
      "JobForm": { "allOf": [{ "$ref": "#/components/schemas/ConversionForm" }, { "type": "object", "properties": { "operation": { "type": "string", "enum": ["ConvertFile", "ConvertAndMerge", "CreateTextPdf"] }, "correlationId": { "type": "string" }, "text": { "type": "string" } } }] },
      "TextPdfRequest": { "type": "object", "required": ["text"], "properties": { "text": { "type": "string" }, "profile": { "type": "string", "default": "archive" }, "watermarkProfile": { "type": "string" }, "watermark": { "type": "object" } } },
      "ApiKeyCreateRequest": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 64 }, "scopes": { "type": "array", "items": { "type": "string" } }, "expiresAt": { "type": "string", "format": "date-time" }, "limits": { "type": "object" } } },
      "JobStatus": { "type": "object", "properties": { "jobId": { "type": "string", "format": "uuid" }, "state": { "type": "string" }, "progressPercent": { "type": "integer" }, "queueWaitMilliseconds": { "type": "integer" }, "processingMilliseconds": { "type": "integer" }, "retryCount": { "type": "integer" }, "inputBytes": { "type": "integer", "format": "int64" }, "outputBytes": { "type": "integer", "format": "int64" }, "compressionPercent": { "type": "number", "format": "double" } } },
      "Problem": { "type": "object", "properties": { "code": { "type": "string" }, "message": { "type": "string" }, "requestId": { "type": "string" }, "retryable": { "type": "boolean" } } }
    },
    "responses": {
      "Pdf": { "description": "Generated PDF", "content": { "application/pdf": { "schema": { "type": "string", "format": "binary" } } } },
