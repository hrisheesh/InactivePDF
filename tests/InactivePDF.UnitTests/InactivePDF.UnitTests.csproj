<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="14.16.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
    <ProjectReference Include="../../src/InactivePDF.Application/InactivePDF.Application.csproj" />
    <ProjectReference Include="../../src/InactivePDF.Client/InactivePDF.Client.csproj" />
    <ProjectReference Include="../../src/InactivePDF.Domain/InactivePDF.Domain.csproj" />
    <ProjectReference Include="../../src/InactivePDF.Infrastructure/InactivePDF.Infrastructure.csproj" />
    <ProjectReference Include="../../src/InactivePDF.Api/InactivePDF.Api.csproj" />
    <None Include="../../InactivePDF.settings.json" Link="InactivePDF.settings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopyConversionWorkerArtifacts" AfterTargets="Build">
    <ItemGroup>
      <ConversionWorkerArtifacts Include="$(MSBuildProjectDirectory)/../../src/InactivePDF.ConversionWorker/bin/$(Configuration)/net10.0/*"
                                  Exclude="$(MSBuildProjectDirectory)/../../src/InactivePDF.ConversionWorker/bin/$(Configuration)/net10.0/InactivePDF.Application.dll;$(MSBuildProjectDirectory)/../../src/InactivePDF.ConversionWorker/bin/$(Configuration)/net10.0/InactivePDF.Domain.dll;$(MSBuildProjectDirectory)/../../src/InactivePDF.ConversionWorker/bin/$(Configuration)/net10.0/InactivePDF.Infrastructure.dll;$(MSBuildProjectDirectory)/../../src/InactivePDF.ConversionWorker/bin/$(Configuration)/net10.0/InactivePDF.Application.pdb;$(MSBuildProjectDirectory)/../../src/InactivePDF.ConversionWorker/bin/$(Configuration)/net10.0/InactivePDF.Domain.pdb;$(MSBuildProjectDirectory)/../../src/InactivePDF.ConversionWorker/bin/$(Configuration)/net10.0/InactivePDF.Infrastructure.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(ConversionWorkerArtifacts)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyCurrentProjectReferences" AfterTargets="CopyConversionWorkerArtifacts">
    <ItemGroup>
      <CurrentProjectReferenceArtifacts Include="$(MSBuildProjectDirectory)/../../src/InactivePDF.Api/bin/$(Configuration)/net10.0/InactivePDF.Api.dll;$(MSBuildProjectDirectory)/../../src/InactivePDF.Application/bin/$(Configuration)/net10.0/InactivePDF.Application.dll;$(MSBuildProjectDirectory)/../../src/InactivePDF.Client/bin/$(Configuration)/netstandard2.0/InactivePDF.Client.dll;$(MSBuildProjectDirectory)/../../src/InactivePDF.Domain/bin/$(Configuration)/net10.0/InactivePDF.Domain.dll;$(MSBuildProjectDirectory)/../../src/InactivePDF.Infrastructure/bin/$(Configuration)/net10.0/InactivePDF.Infrastructure.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(CurrentProjectReferenceArtifacts)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
